{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-de-fotos-tru",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Sitio estático: se publica lo que genera `npm run build` (carpeta dist).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
