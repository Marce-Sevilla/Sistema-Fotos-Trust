{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-de-fotos-tru",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Sitio estático: se publica lo que genera `npm run build` (carpeta dist).
  // Solo /api/* pasa primero por el Worker (el que habla con el CRM); lo demás lo sirve Cloudflare directo.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Conserva las variables y secretos creados en el panel de Cloudflare: sin esto, cada despliegue deja las
  // variables de texto iguales a este archivo y borra las demás (por eso este archivo NO define `vars`).
  "keep_vars": true
  // Se crean en el panel de Cloudflare como SECRET (no van en este archivo): GHL_TOKEN y GHL_LOCATION_ID.
  // Opcionales: GHL_PHOTOS_FIELD_ID (por defecto el campo «Fotos» de Trust, ver worker/api.js), GHL_API_VERSION,
  // GHL_ADD_NOTE, GHL_TAGS. Ver README.
}
