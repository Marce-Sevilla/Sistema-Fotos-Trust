{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-de-fotos-tru",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Sitio estático: se publica lo que genera `npm run build` (carpeta dist).
  // Solo /api/* pasa primero por el Worker (el que habla con el CRM); lo demás lo sirve Cloudflare directo.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ID del campo personalizado «Fotos» (tipo archivo) del contacto en el CRM de Trust. No es secreto.
  "vars": {
    "GHL_PHOTOS_FIELD_ID": "btVvykNbwpKlMzvMK7MA"
  }
  // Secretos (se crean en Cloudflare, NO van en este archivo): GHL_TOKEN y GHL_LOCATION_ID.
  // Opcionales: GHL_API_VERSION, GHL_TAGS. Ver README.
}
